<Window x:Class="Echoflow.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echoflow Settings" Height="580" Width="760"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="#CCCCCC"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="MinWidth" Value="200"/>
        </Style>
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Background" Value="#5B4FE8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Button" x:Key="SecondaryButton">
            <Setter Property="Background" Value="#333333"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#555555"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Border Background="#1E1E1E" CornerRadius="0">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,30">

                <!-- HEADER -->
                <DockPanel Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Echoflow" FontSize="28" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Local dictation for Windows" FontSize="13" Foreground="#888888" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" HorizontalAlignment="Right">
                        <TextBlock x:Name="StatusText" Text="Ready" Foreground="#888888" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#4CAF50" VerticalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>

                <Separator Background="#333333" Margin="0,0,0,20"/>

                <!-- PROCESSING OPTIONS -->
                <TextBlock Text="PROCESSING" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <CheckBox x:Name="ChkAutoPaste" Content="Auto-paste transcribed text at cursor" IsChecked="True"/>
                <CheckBox x:Name="ChkRemoveFillers" Content="Remove filler words (um, uh, you know)" IsChecked="True"/>
                <CheckBox x:Name="ChkSmartFormatting" Content="Smart formatting (capitalization, punctuation)" IsChecked="True"/>
                <CheckBox x:Name="ChkRetainAudio" Content="Retain audio recordings" IsChecked="False"/>

                <Separator Background="#333333" Margin="0,16,0,16"/>

                <!-- HOTKEYS -->
                <TextBlock Text="HOTKEYS" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Dictation:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbDictationHotkey" Grid.Column="1" Margin="8,4,24,4">
                        <ComboBoxItem Content="F12" Tag="123"/>
                        <ComboBoxItem Content="F11" Tag="122"/>
                        <ComboBoxItem Content="F10" Tag="121"/>
                        <ComboBoxItem Content="F9" Tag="120"/>
                    </ComboBox>
                    <Label Grid.Column="2" Content="Undo:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbUndoHotkey" Grid.Column="3" Margin="8,4,0,4">
                        <ComboBoxItem Content="None" Tag="0"/>
                        <ComboBoxItem Content="Ctrl+Z" Tag="1"/>
                    </ComboBox>
                </Grid>

                <Separator Background="#333333" Margin="0,16,0,16"/>

                <!-- MODEL -->
                <TextBlock Text="AI MODEL" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Active Model:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbModel" Grid.Column="1" Margin="8,4,16,4">
                        <ComboBoxItem Content="Base (Faster, Good Accuracy)" Tag="ggml-base.en.bin"/>
                        <ComboBoxItem Content="Small (Slower, High Accuracy)" Tag="ggml-small.en.bin"/>
                    </ComboBox>
                    <Button x:Name="BtnModelAction" Grid.Column="2" Content="Download" Style="{StaticResource PrimaryButton}" Click="BtnModelAction_Click"/>
                </Grid>
                <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,8,0,0" Visibility="Collapsed" Foreground="#5B4FE8" Background="#333333"/>
                <TextBlock x:Name="ModelStatusLabel" Text="" Foreground="#888888" FontSize="11" Margin="0,4,0,0"/>

                <Separator Background="#333333" Margin="0,16,0,16"/>

                <!-- LANGUAGE -->
                <TextBlock Text="LANGUAGE" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Language:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CmbLanguage" Grid.Column="1" Margin="8,4,0,4">
                        <ComboBoxItem Content="English" Tag="en" IsSelected="True"/>
                        <ComboBoxItem Content="Auto-detect" Tag="auto"/>
                        <ComboBoxItem Content="Spanish" Tag="es"/>
                        <ComboBoxItem Content="French" Tag="fr"/>
                        <ComboBoxItem Content="German" Tag="de"/>
                        <ComboBoxItem Content="Hindi" Tag="hi"/>
                        <ComboBoxItem Content="Japanese" Tag="ja"/>
                        <ComboBoxItem Content="Chinese" Tag="zh"/>
                    </ComboBox>
                </Grid>

                <Separator Background="#333333" Margin="0,16,0,16"/>

                <!-- TOOLS -->
                <TextBlock Text="TOOLS" FontSize="11" Foreground="#666666" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="📖 Dictionary" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" Click="BtnDictionary_Click"/>
                    <Button Content="📜 History" Style="{StaticResource SecondaryButton}" Margin="0,0,12,8" Click="BtnHistory_Click"/>
                </WrapPanel>

                <Separator Background="#333333" Margin="0,16,0,16"/>

                <!-- SAVE/CANCEL -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Save" Style="{StaticResource PrimaryButton}" Width="100" Margin="0,0,12,0" Click="BtnSave_Click"/>
                    <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Width="100" Click="BtnCancel_Click"/>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
