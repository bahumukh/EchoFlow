<Window x:Class="Echoflow.UI.HUDWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echoflow HUD" Height="120" Width="420"
        WindowStyle="None" Background="Transparent"
        AllowsTransparency="True" Topmost="True"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        IsHitTestVisible="False">

    <Border x:Name="HudBorder" CornerRadius="22" Background="#E8202020"
            BorderThickness="1" BorderBrush="#33FFFFFF"
            Opacity="0" RenderTransformOrigin="0.5,0.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="Black"/>
        </Border.Effect>

        <Grid Margin="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Icon -->
            <TextBlock x:Name="HudIcon" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                       Text="🎙️" FontSize="28" VerticalAlignment="Center" Margin="0,0,16,0"
                       RenderTransformOrigin="0.5,0.5">
                <TextBlock.RenderTransform>
                    <ScaleTransform x:Name="IconScale" ScaleX="1" ScaleY="1"/>
                </TextBlock.RenderTransform>
            </TextBlock>

            <!-- Title -->
            <TextBlock x:Name="HudTitle" Grid.Row="0" Grid.Column="1"
                       Text="Listening…" Foreground="White" FontSize="17"
                       FontWeight="SemiBold" VerticalAlignment="Bottom"/>

            <!-- Detail -->
            <TextBlock x:Name="HudDetail" Grid.Row="1" Grid.Column="1"
                       Text="Release F12 to transcribe" Foreground="#99FFFFFF"
                       FontSize="12" VerticalAlignment="Top" Margin="0,2,0,0"/>

            <!-- Spinner (for transcribing state) -->
            <TextBlock x:Name="HudSpinner" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                       Text="⏳" FontSize="18" VerticalAlignment="Center"
                       Visibility="Collapsed"/>

            <!-- Waveform bars -->
            <Canvas x:Name="WaveformCanvas" Grid.Row="2" Grid.ColumnSpan="3"
                    Height="28" Margin="0,6,0,0" ClipToBounds="True"/>
        </Grid>
    </Border>
</Window>
