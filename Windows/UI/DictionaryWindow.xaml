<Window x:Class="Echoflow.UI.DictionaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echoflow — Dictionary" Height="450" Width="550"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White"
        ResizeMode="CanResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Custom Dictionary" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,12"/>

        <DataGrid x:Name="DgDictionary" Grid.Row="1"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  Background="#2D2D30" Foreground="White"
                  RowBackground="#2D2D30" AlternatingRowBackground="#333333"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#444444"
                  BorderThickness="1" BorderBrush="#444444"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Spoken Phrase" Binding="{Binding Spoken}" Width="*"
                                    Foreground="White">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#444444"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn Header="Replacement" Binding="{Binding Replacement}" Width="*"
                                    Foreground="White">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                    <DataGridTextColumn.EditingElementStyle>
                        <Style TargetType="TextBox">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="Background" Value="#444444"/>
                        </Style>
                    </DataGridTextColumn.EditingElementStyle>
                </DataGridTextColumn>
                <DataGridCheckBoxColumn Header="Priority" Binding="{Binding Priority}" Width="70"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
            <Button Content="➕ Add Entry" Padding="12,6" Background="#5B4FE8" Foreground="White"
                    BorderThickness="0" Cursor="Hand" Click="BtnAdd_Click"/>
            <Button Content="🗑️ Remove Selected" Padding="12,6" Background="#333333" Foreground="White"
                    BorderThickness="1" BorderBrush="#555" Cursor="Hand" Margin="12,0,0,0" Click="BtnRemove_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Save" Padding="16,8" Background="#5B4FE8" Foreground="White"
                    BorderThickness="0" Width="80" Cursor="Hand" Click="BtnSave_Click"/>
            <Button Content="Cancel" Padding="16,8" Background="#333333" Foreground="White"
                    BorderThickness="1" BorderBrush="#555" Width="80" Cursor="Hand"
                    Margin="12,0,0,0" Click="BtnCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>
