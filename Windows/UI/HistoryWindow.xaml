<Window x:Class="Echoflow.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echoflow — History" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E1E" Foreground="White">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Transcription History" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
            <Button x:Name="BtnClear" Content="Clear All" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Padding="12,6" Background="#333333" Foreground="#FF4444" BorderThickness="1" BorderBrush="#555"
                    Cursor="Hand" Click="BtnClear_Click"/>
        </DockPanel>

        <ListBox x:Name="LstHistory" Grid.Row="1" Background="#2D2D30" BorderThickness="1" BorderBrush="#444444"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderThickness="0,0,0,1" BorderBrush="#444444" Padding="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{Binding FinalText}" TextWrapping="Wrap" Foreground="White" FontSize="14" Margin="0,0,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FormattedDate}" Foreground="#888888" FontSize="11" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding ApplicationName}" Foreground="#888888" FontSize="11" Margin="0,0,12,0"/>
                                    <TextBlock Text="{Binding FormattedDuration}" Foreground="#888888" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Copy" Padding="12,6" Background="#333333" Foreground="White"
                                    BorderThickness="1" BorderBrush="#555" Cursor="Hand" VerticalAlignment="Top"
                                    Tag="{Binding FinalText}" Click="BtnCopy_Click"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button x:Name="BtnClose" Grid.Row="2" Content="Close" Margin="0,12,0,0" Padding="16,8"
                HorizontalAlignment="Right" Background="#5B4FE8" Foreground="White" BorderThickness="0"
                Cursor="Hand" Width="80" Click="BtnClose_Click"/>
    </Grid>
</Window>
